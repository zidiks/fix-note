# Voice Notes - Environment Variables
# Copy this file to .env and fill in your values

# ===========================================
# TELEGRAM
# ===========================================
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Comma-separated list of allowed Telegram user IDs
# Leave empty to allow all users
ALLOWED_USER_IDS=

# ===========================================
# SUPABASE
# ===========================================
# Your Supabase project URL
SUPABASE_URL=https://your-project.supabase.co

# Supabase anon (public) key
SUPABASE_ANON_KEY=eyJ...

# Supabase service role key (JWT format, starts with eyJ...)
# Get it from: Dashboard -> Settings -> API -> Legacy API Keys -> service_role
SUPABASE_SERVICE_KEY=eyJ...

# ===========================================
# AI SERVICES
# ===========================================
# DeepSeek API for summarization
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_API_URL=https://api.deepseek.com

# OpenAI API for embeddings (legacy, optional)
OPENAI_API_KEY=

# ===========================================
# EMBEDDINGS + VECTOR DB (Self-hosted)
# ===========================================
EMBEDDINGS_API_URL=http://embeddings:80
EMBEDDINGS_MODEL=intfloat/multilingual-e5-base
EMBEDDINGS_DIMENSIONS=768
EMBEDDINGS_TIMEOUT_SEC=30
VECTOR_DB_URL=http://qdrant:6333
VECTOR_DB_API_KEY=
VECTOR_DB_COLLECTION=notes_embeddings

# ===========================================
# WHISPER (Speech-to-Text)
# ===========================================
# Local Whisper service URL (Docker)
WHISPER_API_URL=http://whisper:9000

# ===========================================
# SERVER
# ===========================================
# API server port
API_PORT=8000

# Public URL for Telegram Mini App (with HTTPS)
# Example: https://notes.your-domain.com
PUBLIC_URL=

# ===========================================
# NOTION INTEGRATION (Optional)
# ===========================================
# Create a Notion integration at https://www.notion.so/my-integrations
# Required for sync feature
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=

# ===========================================
# NOTES ENCRYPTION
# ===========================================
# Base64-encoded 32-byte master key
NOTES_MASTER_KEY=
NOTES_MASTER_KEY_VERSION=1

# ===========================================
# NATIVE APP AUTH (JWT)
# ===========================================
# Random secret for signing JWT tokens (min 32 chars)
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=90

# ===========================================
# APPLE SIGN IN + IAP
# ===========================================
# Bundle ID of your iOS app (e.g. com.fixnote.app)
APPLE_BUNDLE_ID=com.fixnote.app
# Shared secret from App Store Connect → App → Subscriptions → App-Specific Shared Secret
APPLE_IAP_SHARED_SECRET=

# ===========================================
# GOOGLE SIGN IN + GOOGLE PLAY BILLING
# ===========================================
# Android package name (e.g. com.fixnote.app)
GOOGLE_PLAY_PACKAGE_NAME=com.fixnote.app
# Service account JSON key (paste the full JSON as a single line)
# Create at: Google Play Console → Setup → API access → Service accounts
GOOGLE_SERVICE_ACCOUNT_KEY=


